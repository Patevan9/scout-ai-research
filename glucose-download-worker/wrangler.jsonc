{
  // Glucose Glance download helper. Deploy: npx wrangler deploy
  "name": "glucose-download",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "kv_namespaces": [
    // Filled in after: npx wrangler kv namespace create glucose-download
    { "binding": "DL", "id": "d1198451db184b5eb75bb773252f9e5f" }
  ],
  "vars": {
    "PAYMENT_LINK_ID": "plink_1UdZxK0ynfmB2RtWyRFqMlef",
    "MAX_DOWNLOADS": "3",
    "WINDOW_HOURS": "48",
    "START_WITHIN_DAYS": "14",
    "FILE_NAME": "Glucose-Glance-Installer.apk",
    "SUPPORT_EMAIL": "lippyroboticslabs@gmail.com",
    "SITE_URL": "https://lippyroboticslabs.com/glucose-glance/"
  }
  // Secret STRIPE_KEY is set in the Cloudflare dashboard (restricted key, Checkout Sessions: Read). Never put it here.
}
